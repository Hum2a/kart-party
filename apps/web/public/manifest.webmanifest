{
  "id": "/",
  "name": "Kart Party",
  "short_name": "Kart Party",
  "description": "A free kart racer. Drift, boost and throw items on original tracks, alone or with friends. Practice works offline.",
  "lang": "en-GB",
  "start_url": "/",
