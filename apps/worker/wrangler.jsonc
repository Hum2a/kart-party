{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the built web app and the room API.
  "name": "kart-party-local",
  // The account that holds the humza.website zone.
  "account_id": "e6d408ebc85e159e6e22ee963641d342",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-22",
  "vars": {
    "APP_ENV": "local",
  },
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Include the bare prefix. A pattern of /api/* does not match /api.
    "run_worker_first": ["/api", "/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "KART_ROOM", "class_name": "KartRoom" },
      { "name": "ROOM_DIRECTORY", "class_name": "RoomDirectory" },
    ],
  },
  // Add a later tag only for a new class. Do not delete or recreate a class.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KartRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDirectory"] },
  ],
  "env": {
    "production": {
      "name": "kart-party",
      "workers_dev": false,
      "observability": { "enabled": true },
      "routes": [{ "pattern": "kart.humza.website", "custom_domain": true }],
      "vars": { "APP_ENV": "production" },
      "durable_objects": {
        "bindings": [
          { "name": "KART_ROOM", "class_name": "KartRoom" },
          { "name": "ROOM_DIRECTORY", "class_name": "RoomDirectory" },
        ],
      },
    },
  },
}
