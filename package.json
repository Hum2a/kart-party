{
  "name": "kart-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kart-party/web",
    "build": "npm run build -w @kart-party/web",
    "preview": "npm run preview -w @kart-party/web",
    "deploy": "npm run build && npm run deploy -w @kart-party/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:game": "npm run test -w @kart-party/game",
    "test:web": "npm run test -w @kart-party/web",
    "test:worker": "npm run test -w @kart-party/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "workerd@1.20260921.1": true
  }
}
